# ---------------------------------------------------------------------------
# DIGO EVOLUTION - environment variables
# Copy to .env for local development. In AppJet hosting add these in
# Settings -> Environment variables. Never commit real secret values.
# ---------------------------------------------------------------------------

# Port the Node server listens on (AppJet provides this automatically).
PORT=3000

# Secret used to sign short-lived run tokens that the server issues at the
# start of a run and verifies when the score is submitted.
# Leave empty in development to auto-generate a random per-process secret.
RUN_SECRET=

# PostgreSQL connection for production. Use the private Docker network hostname.
# Example format only; put the real password in the VPS .env, never commit it.
DATABASE_URL=postgresql://digogame:REPLACE_WITH_SECRET@digogame-postgres:5432/digogame

# Where the legacy JSON snapshot is persisted (not used by PostgreSQL runtime).
# Empty = in-memory only (resets when the app restarts, which is the default
# on the free hosting tier where no persistent disk is attached).
DATA_DIR=

# Public Solana cluster used for optional wallet display only.
# The game never sends transactions and never asks for keys.
SOLANA_CLUSTER=mainnet-beta

# Comma separated list of allowed origins for the API. Empty = same origin.
ALLOWED_ORIGINS=
